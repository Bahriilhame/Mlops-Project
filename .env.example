# Docker Compose: public browser URLs, injected at frontend build time.
VITE_API_URL=http://localhost:4201
VITE_MLFLOW_URL=http://localhost:4202
VITE_DAGSTER_URL=http://localhost:4204
DASHBOARD_PORT=4203
DAGSTER_PORT=4204
# Training worker only; leave capacity for the OS and serving containers.
TRAINING_CPUS=1.0
TRAINING_MEMORY=1536m
# Comma-separated frontend origins; adapt for production.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:4203
